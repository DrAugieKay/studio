
/**
 * @fileoverview Firestore Security Rules for the Advisory Insights Platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for participant-related data,
 * ensuring that only the participant can access their own data. Admin users, identified
 * by a custom token claim (`admin: true`), are granted read-only access to all
 * participant data for monitoring and analysis, and full delete privileges for data management.
 *
 * Data Structure:
 * The Firestore data is structured hierarchically, with experiment metadata at the top level,
 * followed by participants, and then responses, derived composites, and data quality flags
 * nested under each participant.
 *
 * Key Security Decisions:
 * - No public data access.
 * - Strict ownership for participant data writes (`isOwner`).
 * - Read access is granted to the owner OR an admin.
 * - List operations (reading a collection) are restricted to admins only.
 * - Admin audit logs are append-only for admins.
 * - Admins have full delete privileges across all participant data for maintenance.
 *
 * Denormalization for Authorization:
 * This ruleset uses path-based authorization, assuming that the correct participant ID
 * is embedded in the document path. This avoids the need for `get()` calls to verify
 * ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by an admin user.
     * Admins have a custom token claim `admin` set to `true`.
     * This is a safe check that handles cases where token or claims might not exist.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    /**
     * @description Checks if the request is made by the owner (userId matches request.auth.uid).
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Rules for the /experiment_meta/{experimentMetaId} collection.
     * @path /experiment_meta/{experimentMetaId}
     */
    match /experiment_meta/{experimentMetaId} {
      // Admins can read, no one else.
      allow get: if isAdmin();
      // Only signed-in users (the survey app itself) can create/update meta.
      allow create, update: if isSignedIn();
      // No one can list or delete the top-level meta doc via client SDK.
      allow list, delete: if false;

      /**
       * @description Rules for the /experiment_meta/{experimentMetaId}/participants collection.
       * @path /experiment_meta/{experimentMetaId}/participants/{participantId}
       */
      match /participants/{participantId} {
        // Admins can list all participant documents. Owners can read their own.
        allow list: if isAdmin();
        allow get: if isOwner(participantId) || isAdmin();
        // Only the participant can create or update their own data.
        allow create, update: if isOwner(participantId);
        // Admins can delete a participant document. THIS IS THE CRITICAL FIX.
        allow delete: if isAdmin();

        /**
         * @description Recursive rule for all subcollections under a participant.
         * This grants admins full read/delete access to all nested data,
         * while participants retain write access to their own nested data.
         */
        match /{document=**} {
           allow get, list, delete: if isAdmin();
           allow create, update: if isOwner(participantId);
        }
      }
    }

    /**
     * @description Rules for the /admin_audit_logs/{adminAuditLogId} collection.
     * @path /admin_audit_logs/{adminAuditLogId}
     */
    match /admin_audit_logs/{adminAuditLogId} {
      allow read, list, create: if isAdmin();
      allow update, delete: if false; // Audit logs should be immutable.
    }
  }
}
