/**
 * @fileoverview Firestore Security Rules for the Advisory Insights Platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for participant-related data,
 * ensuring that only the participant can access their own data. Admin users, identified
 * by a custom token claim (`admin: true`), are granted read-only access to all
 * participant data for monitoring and analysis, and full delete privileges for data management.
 *
 * Data Structure:
 * The Firestore data is structured hierarchically, with experiment metadata at the top level,
 * followed by participants, and then responses, derived composites, and data quality flags
 * nested under each participant.
 *
 * Key Security Decisions:
 * - No public data access.
 * - Strict ownership for participant data writes (`isOwner`).
 * - Read access is granted to the owner OR an admin.
 * - List operations (reading a collection) are restricted to admins only.
 * - Admin audit logs are append-only for admins.
 * - Admins have full delete privileges across all participant data for maintenance.
 *
 * Denormalization for Authorization:
 * This ruleset uses path-based authorization, assuming that the correct participant ID
 * is embedded in the document path. This avoids the need for `get()` calls to verify

 * ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by an admin user.
     * Admins have a custom token claim `admin` set to `true`.
     * This is a safe check that handles cases where token or claims might not exist.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    /**
     * @description Checks if the request is made by the owner (userId matches request.auth.uid).
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     ci */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Rules for the /experiment_meta/{experimentMetaId} collection.
     * @path /experiment_meta/{experimentMetaId}
     * @allow (create, update) Authenticated user can create or update an experiment_meta document.
     * @deny (get, list, delete) No one can read, list or delete experiment meta documents.
     * @principle Enforces that experiment_meta documents can only be written by an authenticated user.
     */
    match /experiment_meta/{experimentMetaId} {
      allow get, list, delete: if false;
      allow create, update: if isSignedIn();
    }

    /**
     * @description Rules for the /experiment_meta/{experimentMetaId}/participants/{participantId} collection.
     * @path /experiment_meta/{experimentMetaId}/participants/{participantId}
     * @allow (list) Admins can list all participant documents.
     * @allow (read) The participant can read their own document, or an admin can read any document.
     * @allow (write) Only the participant can write to their own document.
     * @allow (delete) Admins can delete documents.
     * @principle Enforces that participant documents can only be written by the owner, but can be read by the owner or an admin, and deleted by an admin.
     */
    match /experiment_meta/{experimentMetaId}/participants/{participantId} {
      allow list: if isAdmin();
      allow read: if isOwner(participantId) || isAdmin();
      allow write: if isOwner(participantId);
      allow delete: if isAdmin();

      /**
       * @description Rules for the /experiment_meta/{experimentMetaId}/participants/{participantId}/responses/{responseId} collection.
       * @path /experiment_meta/{experimentMetaId}/participants/{participantId}/responses/{responseId}
       * @allow (read) The participant can read their own responses, or an admin can.
       * @allow (write) Only the participant can write their own responses.
       * @allow (delete) Admins can delete documents.
       */
      match /responses/{responseId} {
         allow list: if isAdmin();
         allow read: if isOwner(participantId) || isAdmin();
         allow write: if isOwner(participantId);
         allow delete: if isAdmin();

        /**
         * @description Rules for the /experiment_meta/{experimentMetaId}/participants/{participantId}/responses/{responseId}/objective_linguistic_analysis/{objectiveLinguisticAnalysisId} collection.
         * @path /experiment_meta/{experimentMetaId}/participants/{participantId}/responses/{responseId}/objective_linguistic_analysis/{objectiveLinguisticAnalysisId}
         */
        match /objective_linguistic_analysis/{objectiveLinguisticAnalysisId} {
           allow list: if isAdmin();
           allow read: if isOwner(participantId) || isAdmin();
           allow write: if isOwner(participantId);
           allow delete: if isAdmin();
        }

        /**
         * @description Rules for the /experiment_meta/{experimentMetaId}/participants/{participantId}/responses/{responseId}/manual_coding/{manualCodingId} collection.
         * @path /experiment_meta/{experimentMetaId}/participants/{participantId}/responses/{responseId}/manual_coding/{manualCodingId}
         */
        match /manual_coding/{manualCodingId} {
           allow list: if isAdmin();
           allow read: if isOwner(participantId) || isAdmin();
           allow write: if isOwner(participantId);
           allow delete: if isAdmin();
        }
      }

      /**
       * @description Rules for the /experiment_meta/{experimentMetaId}/participants/{participantId}/derived_composites/{derivedCompositeId} collection.
       * @path /experiment_meta/{experimentMetaId}/participants/{participantId}/derived_composites/{derivedCompositeId}
       */
      match /derived_composites/{derivedCompositeId} {
         allow list: if isAdmin();
         allow read: if isOwner(participantId) || isAdmin();
         allow write: if isOwner(participantId);
         allow delete: if isAdmin();
      }

      /**
       * @description Rules for the /experiment_meta/{experimentMetaId}/participants/{participantId}/data_quality_flags/{dataQualityFlagId} collection.
       * @path /experiment_meta/{experimentMetaId}/participants/{participantId}/data_quality_flags/{dataQualityFlagId}
       */
      match /data_quality_flags/{dataQualityFlagId} {
         allow list: if isAdmin();
         allow read: if isOwner(participantId) || isAdmin();
         allow write: if isOwner(participantId);
         allow delete: if isAdmin();
      }

      /**
       * @description Rules for the /experiment_meta/{experimentMetaId}/participants/{participantId}/payment_reconciliation/{paymentReconciliationId} collection.
       * @path /experiment_meta/{experimentMetaId}/participants/{participantId}/payment_reconciliation/{paymentReconciliationId}
       */
      match /payment_reconciliation/{paymentReconciliationId} {
         allow list: if isAdmin();
         allow read: if isOwner(participantId) || isAdmin();
         allow write: if isOwner(participantId);
         allow delete: if isAdmin();
      }
    }


    /**
     * @description Rules for the /admin_audit_logs/{adminAuditLogId} collection.
     * @path /admin_audit_logs/{adminAuditLogId}
     * @allow (create) Authenticated user can create an admin_audit_log document.
     * @deny (get, list, update, delete) No one can get, list, update, or delete admin_audit_log documents.
     * @principle Enforces that only authenticated users can create admin_audit_log documents, and no one can read or modify them.
     */
    match /admin_audit_logs/{adminAuditLogId} {
      allow update, delete: if false;
      allow get, list, create: if isAdmin();
    }
  }
}

    